<Window x:Class="CurePaw.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurePaw"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Информация о категории" MinHeight="200" SizeToContent="Height" Width="300">
    
    <StackPanel Margin="20">
        <Label Content="Категория"/>
        <ComboBox Name="CategoryCombo" ItemsSource="{Binding CategoriesList}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentCategory, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="Наименование"/>
        <TextBox Name="NameField" Text="{Binding CurrentCategory.Name, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="Услуги"/>

        <xctk:CheckComboBox Name="ServicesCombo" 
            ItemsSource="{Binding ServicesList}"
            DisplayMemberPath="ServiceName"
            SelectedMemberPath="IsSelected"
            Delimiter=", "/>



        <Button Content="Сохранить" Click="SaveBtn_Click" Margin="20 20 20 0"/>
    </StackPanel>
</Window>
