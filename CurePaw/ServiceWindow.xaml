<Window x:Class="CurePaw.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurePaw"
        mc:Ignorable="d"
        Title="Информаци об услуге" MinHeight="250" SizeToContent="Height" Width="300">

    <StackPanel Margin="20">
        <Label Content="Услуга"/>
        <ComboBox Name="ServiceCombo" 
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding CurrentService, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
        <Label Content="Наименование"/>
        <TextBox Name="NameField" 
                 Text="{Binding CurrentService.Name, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="Стоимость"/>
        <TextBox Name="PriceField" 
                 Text="{Binding CurrentService.Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}, TargetNullValue=0}"
                 PreviewTextInput="PriceField_PreviewTextInput"/>
        <Label Content="Категория"/>
        <ComboBox Name="CategoryCombo" 
           DisplayMemberPath="Name"
           SelectedItem="{Binding CurrentService.ServiceCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
        <Button Content="Сохранить" IsDefault="True" Click="SaveBtn_Click" Margin="20 20 20 0"/>
    </StackPanel>
</Window>
