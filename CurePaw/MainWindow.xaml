<Window x:Class="CurePaw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:CurePaw"
        mc:Ignorable="d"
        Title="Ветеринарная клиника CurePaw" MinHeight="500" Height="470" Width="800" MinWidth="620">

    <Grid Margin="10 0 10 5">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.12*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="40">
            <Button Content="Войти" Click="LoginBtn_Click" Margin="0 0 20 0" Height="25"/>
            <Button Content="Зарегистрироваться" Click="RegisterBtn_Click" Height="25"/>
        </StackPanel>

        <TabControl Name="MyTabControl" Grid.Row="1">
            <TabItem Name="ServicesTab" Header="Список услуг" Margin="0 0 0 5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Панель фильтров и поиска -->
                        <RowDefinition Height="*"/>
                        <!-- Основное содержимое -->
                    </Grid.RowDefinitions>

                    <!-- ПАНЕЛЬ ПОИСКА И ФИЛЬТРАЦИИ -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0 0 0 15">
                        <!-- Кнопка добавления услуги (видима админу) -->
                        <Button Name="AddServiceBtn" Content="Добавить услугу" Click="AddServiceBtn_Click" Visibility="Collapsed" Margin="0 0 20 0"/>

                        <!-- Поиск по названию -->
                        <Label Content="Поиск:" VerticalAlignment="Center"/>
                        <TextBox Name="SearchField" Width="150" Margin="5 0 20 0" VerticalContentAlignment="Center" TextChanged="SearchField_TextChanged"/>

                        <!-- Фильтр по категориям -->
                        <Label Content="Категория:" VerticalAlignment="Center"/>
                        <ComboBox Name="CategoryFilterCombo" Width="150" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CategoryFilterCombo_SelectionChanged" VerticalContentAlignment="Center"/>

                        <!-- Кнопка сброса -->
                        <Button Name="ResetFiltersBtn" Content="Сбросить" Click="ResetFiltersBtn_Click" Margin="15 0 0 0" Height="25"/>
                    </StackPanel>

                    <!-- Таблица услуг с новой колонкой Категории -->
                    <DataGrid Name="ServicesTable" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="ServicesTable_SelectionChanged"
                  MouseDoubleClick="ServicesTable_MouseDoubleClick"
                  PreviewKeyDown="ServicesTable_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                            <!-- НОВАЯ КОЛОНКА -->
                            <DataGridTextColumn Header="Категория" Binding="{Binding ServiceCategory.Name, TargetNullValue='Без категории'}" Width="1.5*"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding Price}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель записи (для обычного клиента) -->
                    <StackPanel Name="AppointmentPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed" Margin="0 15 0 0">
                        <Label Content="Оформление заявки" HorizontalAlignment="Center" FontSize="16" />

                        <StackPanel Margin="20 10">
                            <Label Content="Питомец"/>
                            <xctk:CheckComboBox Name="PetCombo" 
                                    ItemsSource="{Binding PetsList}"
                                    DisplayMemberPath="Pet.Name"
                                    SelectedMemberPath="IsSelected"
                                    Delimiter=", "/>

                            <Label Content="Сотрудник"/>
                            <ComboBox Name="EmployeeCombo" DisplayMemberPath="FullName"
                          SelectionChanged="EmployeeCombo_SelectionChanged"/>

                            <Label Content="Услуги"/>
                            <xctk:CheckComboBox Name="ServicesCombo" 
                                    ItemsSource="{Binding ServicesList}"
                                    DisplayMemberPath="Service.Name"
                                    SelectedMemberPath="IsSelected"
                                    Delimiter=", "/>

                            <Label Content="Дата приема"/>
                            <DatePicker Name="AppointmentDatePicker" 
                        DisplayDateStart="{Binding StartDate, Mode=OneWay}" 
                        DisplayDateEnd="{Binding EndDate, Mode=OneWay}"/>

                            <Button Content="Подтвердить" Margin="0 20 0 0" Click="CreateAppointmentBtn_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Список записей (для сотрудников и админов) -->
                    <StackPanel Name="AllAppointmentsPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed">
                        <Button Name="FinishAppointmentBtn" Click="FinishAppointmentBtn_Click" Content="Завершить запись" Visibility="Collapsed" Margin="0 0 0 15"/>

                        <Label Content="Записи"/>

                        <DataGrid Name="AppointmentsTable" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      PreviewKeyDown="AppointmentsTable_PreviewKeyDown"
                      SelectionChanged="AppointmentsTable_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding ClientFullName, Mode=OneWay}"/>
                                <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName, Mode=OneWay}"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"/>
                                <DataGridTemplateColumn Header="Статус">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AppointmentStatu.Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.StatusesList, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectionChanged="StatusTableComboBox_SelectionChanged"
                                      SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Grid>
            </TabItem>

            <TabItem Name="EmployeeTab" Header="Сотрудники" Margin="0 0 0 5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 0: Кнопки добавления -->
                        <RowDefinition Height="1.2*"/>
                        <!-- Строка 1: Таблицы сотрудников и их услуг -->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 2: Разделитель (Separator) -->
                        <RowDefinition Height="*"/>
                        <!-- Строка 3: Панель администрирования категорий -->
                    </Grid.RowDefinitions>

                    <!-- Кнопка добавления сотрудника -->
                    <Button Name="AddEmployeeBtn" Content="Добавить сотрудника" Grid.Column="0" Grid.Row="0" Visibility="Collapsed" Click="AddEmployeeBtn_Click" Margin="0 0 0 10"/>

                    <!-- Левая таблица: Сотрудники -->
                    <DataGrid Name="EmployeeTable" 
                  AutoGenerateColumns="False" 
                  SelectionChanged="EmployeeTable_SelectionChanged" 
                  IsReadOnly="True" 
                  Grid.Column="0" 
                  Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="EmployeeTable_MouseDoubleClick"
                  PreviewKeyDown="EmployeeTable_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname}"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Отчество" Binding="{Binding Patronymic}"/>
                            <DataGridTextColumn Header="Специальность" Binding="{Binding EmployeeSpeciality.Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Правая таблица: Сводная таблица "Сотрудник - Услуги" -->
                    <DataGrid Name="CategoriesTable" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Grid.Column="2" 
                  Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="CategoriesTable_SelectionChanged"
                  MouseDoubleClick="CategoriesTable_MouseDoubleClick"
                  PreviewKeyDown="CategoriesTable_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.FullName}"/>
                            <DataGridTextColumn Header="Услуги" Binding="{Binding ServicesStr}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Декоративный разделитель между секциями -->
                    <Separator Grid.Row="2" Grid.ColumnSpan="3" Margin="0 15"/>

                    <!-- ПАНЕЛЬ АДМИНИСТРАТОРА (Управление категориями) -->
                    <Grid Name="AdminCategoryPanel" Grid.Row="3" Grid.ColumnSpan="3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Таблица категорий для админа -->
                        <DataGrid Name="AdminCategoriesTable" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Grid.Column="2"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="AdminCategoriesTable_SelectionChanged"
                      MouseDoubleClick="AdminCategoriesTable_MouseDoubleClick"
                      PreviewKeyDown="AdminCategoriesTable_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Форма управления категорией -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="10 0">
                            <Label Content="Управление категориями" FontSize="14" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <Label Content="Название категории" Margin="0 10 0 0"/>
                            <TextBox Name="CategoryNameField" Margin="0 0 0 15" Height="25" VerticalContentAlignment="Center"/>
                            <Button Name="SaveCategoryBtn" Content="Сохранить категорию" Click="SaveCategoryBtn_Click" Height="28"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Name="DashboardTab" Header="Личный кабинет" Visibility="Collapsed" Margin="0 0 0 5">
                <Grid Margin="15 15 15 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Name="UserDataPanel" Grid.Row="0">
                        <Label Content="Фамилия"/>
                        <TextBox Name="SurnameField" Text="{Binding CurrentUser.Surname}"/>
                        <Label Content="Имя"/>
                        <TextBox Name="NameField" Text="{Binding CurrentUser.Name}"/>
                        <Label Content="Отчество"/>
                        <TextBox Name="PatronymicField" Text="{Binding CurrentUser.Patronymic}"/>
                        <Label Content="Email"/>
                        <TextBox Name="EmailField" Text="{Binding CurrentUser.Email}"/>
                        <Label Content="Телефон"/>
                        <TextBox Name="PhoneField" Text="{Binding CurrentUser.Phone}"/>

                    </StackPanel>

                    <Button Content="Сохранить" Click="SaveUserDataBtn_Click" Grid.Column="0" Grid.Row="1" Margin="40 30 40 0"/>

                    <TabControl Name="DashboardSideControl" 
            TabStripPlacement="Right"
            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
            Grid.Column="3" Grid.Row="0"
            Background="Transparent"
            materialDesign:ColorZoneAssist.Mode="Standard"
            materialDesign:NavigationRailAssist.ShowSelectionBackground="True">

                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Width" Value="76"/>
                                <Setter Property="Height" Value="68"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </TabControl.Resources>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel VerticalAlignment="Center" Margin="0,5">
                                    <materialDesign:PackIcon Kind="Paw" 
                                         Width="22" Height="22" 
                                         HorizontalAlignment="Center" 
                                         Margin="0,0,0,4"/>
                                    <TextBlock Text="Питомцы" 
                           FontSize="10" 
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <StackPanel Margin="0 0 10 0">
                                <Button Content="Добавить питомца" Click="AddPetBtn_Click" Margin="20 30 20 10"/>

                                <DataGrid Name="PetTable"
                    SelectionChanged="PetTable_SelectionChanged"  
                    AutoGenerateColumns="False" IsReadOnly="True" 
                    MouseDoubleClick="PetTable_MouseDoubleClick"
                    PreviewKeyDown="PetTable_PreviewKeyDown"
                    HorizontalScrollBarVisibility="Auto">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Кличка" Binding="{Binding Name}"/>
                                        <DataGridTextColumn Header="Порода" Binding="{Binding Breed}"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding PetType.Name}"/>
                                        <DataGridTextColumn Header="Доп информация" Binding="{Binding Description}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel VerticalAlignment="Center" Margin="0,5">
                                    <materialDesign:PackIcon Kind="ClipboardListOutline" 
                                         Width="22" Height="22" 
                                         HorizontalAlignment="Center" 
                                         Margin="0,0,0,4"/>
                                    <TextBlock Text="Записи" 
                           FontSize="10" 
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <StackPanel>
                                <Button Content="Добавить запись" Margin="20 30 20 10"
                    Click="RefToAddAppoinmentBtn_Click"/>

                                <DataGrid Name="UserAppointmentsTable" IsReadOnly="True" AutoGenerateColumns="False" Margin="0 0 10 0"
                      PreviewKeyDown="UserAppointmentsTable_PreviewKeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Pet.Name}" Header="Питомцы"/>
                                        <DataGridTextColumn Binding="{Binding Employee.FullName}" Header="Сотрудник"/>
                                        <DataGridTextColumn Binding="{Binding ServicesText}" Header="Услуги"/>
                                        <DataGridTextColumn Binding="{Binding Appointment.Date, StringFormat={}{0:dd.MM.yyyy}}" Header="Дата"/>
                                        <DataGridTextColumn Binding="{Binding Status.Name}" Header="Статус"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>